<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 / 选择清理范围。
  静态头部（标题、存储卡、分组标题）固定，只有范围与月份列表滚动。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- ============ 顶部：标题 + 设置 ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <View
                android:layout_width="@dimen/title_underline_w"
                android:layout_height="@dimen/title_underline_h"
                android:layout_marginTop="@dimen/title_underline_gap"
                android:background="@drawable/bg_title_underline" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/ink" />
    </LinearLayout>

    <!-- ============ 权限面板 ============ -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:visibility="gone">

        <ImageView
            android:layout_width="@dimen/permission_icon_size"
            android:layout_height="@dimen/permission_icon_size"
            android:background="@drawable/bg_status_icon"
            android:contentDescription="@null"
            android:padding="17dp"
            android:src="@drawable/ic_scope_all"
            app:tint="@color/brand_orange" />

        <TextView
            style="@style/Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/permission_denied_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/permission_denied_body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permissionRetryButton"
            style="@style/Widget.SwipeKeep.Cta.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/permission_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permissionSettingsButton"
            style="@style/Widget.SwipeKeep.Cta.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/permission_go_settings" />
    </LinearLayout>

    <!--
      上次没做完的清理。外层只负责显隐且不带 margin；
      间距放在内层卡片上，避免 GONE 后仍参与定位。
    -->
    <FrameLayout
        android:id="@+id/pendingBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding_h"
            android:layout_marginTop="@dimen/space_4"
            app:cardBackgroundColor="@color/surface_soft"
            app:cardCornerRadius="@dimen/panel_corner"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_history"
                        app:tint="@color/brand_orange" />

                    <TextView
                        android:id="@+id/pendingText"
                        style="@style/Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:textColor="@color/tip_text"
                        tools:text="上次有 128 张待删除" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pendingDiscard"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="@dimen/space_2"
                        android:paddingVertical="6dp"
                        android:text="@string/scope_pending_discard"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/pendingResume"
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="@dimen/space_2"
                        android:paddingVertical="6dp"
                        android:text="@string/scope_pending_resume"
                        android:textColor="@color/brand_orange" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ============ 存储卡 ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/storageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_4"
        app:cardBackgroundColor="@color/surface_soft"
        app:cardCornerRadius="@dimen/panel_corner"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pendingBanner"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <com.lancer.swipekeep.ui.widget.DonutProgressView
                android:id="@+id/storageDonut"
                android:layout_width="@dimen/donut_size"
                android:layout_height="@dimen/donut_size" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/storageUsed"
                    style="@style/Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="已用 78 GB / 115 GB" />

                <TextView
                    android:id="@+id/storageAdvice"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    tools:text="相册占 423 MB，挑不要的就能腾地方" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pickTitle"
        style="@style/Text.SectionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/scope_pick_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/storageCard" />

    <TextView
        android:id="@+id/emptyHint"
        style="@style/Text.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="center"
        android:text="@string/scope_empty"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pickTitle"
        tools:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_3"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pickTitle"
        tools:itemCount="4"
        tools:listitem="@layout/item_scope_row" />

    <!-- ============ 底部 CTA ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            style="@style/Widget.SwipeKeep.Cta.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cta_start" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
