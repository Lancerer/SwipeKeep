<?xml version="1.0" encoding="utf-8"?>
<!--
  滑卡清理主界面（设计图 01）。

  纵向骨架自上而下：顶栏（标题 + 进度）→ 卡片堆（吃掉剩余高度）→ 滑动提示 → 三个控制键。

  卡片堆用 0dp 高度而不是写死尺寸：卡片自己按可用空间算尺寸（见 SwipeCardStackView.onMeasure），
  窄屏上整体缩小而不是被裁掉。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- ============ 顶栏：标题 + 回收站入口 + 进度 ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <View
                    android:layout_width="@dimen/title_underline_w"
                    android:layout_height="@dimen/title_underline_h"
                    android:layout_marginTop="@dimen/title_underline_gap"
                    android:background="@color/brand_orange" />
            </LinearLayout>

            <!--
              提前结束。放在回收站左侧：marginEnd 让出回收站的触摸盒（12dp padding + 32dp 图标），
              视觉间隔正好是回收站自带的 padding，两个命中区不重叠。
              高度用 minHeight 而不是写死 32dp —— 大字体下文字不会被裁。
            -->
            <TextView
                android:id="@+id/endButton"
                style="@style/Text.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginEnd="44dp"
                android:minHeight="@dimen/icon_btn_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/swipe_end"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
              回收站入口。给图标留一点 start/bottom padding：触摸区从 32dp 扩到 44dp，
              而图标与徽标的位置分毫未动（end|top 对齐的是内容区，paddingEnd/Bottom 都是 0）。
            -->
            <FrameLayout
                android:id="@+id/trashButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="@dimen/icon_btn_size"
                    android:layout_height="@dimen/icon_btn_size"
                    android:layout_gravity="end|top"
                    android:contentDescription="@string/cd_trash"
                    android:padding="5dp"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/ink" />

                <TextView
                    android:id="@+id/trashBadge"
                    android:layout_width="@dimen/badge_size"
                    android:layout_height="@dimen/badge_size"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/badge_text"
                    android:textStyle="bold"
                    tools:text="12" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/progressText"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/progress_gap"
            tools:text="2024 年 5 月 · 已看 128 / 356 张" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_h"
            android:layout_marginTop="@dimen/progress_gap"
            android:progressDrawable="@drawable/bg_progress_horizontal"
            tools:max="356"
            tools:progress="128" />
    </LinearLayout>

    <!-- ============ 卡片堆 ============ -->
    <com.lancer.swipekeep.ui.widget.SwipeCardStackView
        android:id="@+id/cardStack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/hintRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ============ 空 / 看完了：占住卡片堆的位置 ============ -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardStack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardStack">

        <TextView
            android:id="@+id/statusText"
            style="@style/Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="这个范围里没有照片" />

        <!--
          看完了才有意义 —— 空范围（「这个范围里没有照片」）没有可结算的东西，
          所以它跟着 `finished` 一起显隐，由 SwipeFragment.render 决定。
        -->
        <TextView
            android:id="@+id/statusSettle"
            style="@style/Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cta_h"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_cta_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="44dp"
            android:text="@string/swipe_view_settlement"
            android:textColor="@color/white"
            android:textSize="@dimen/cta_text"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/statusBack"
            style="@style/Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cta_secondary_h"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_cta_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="@string/swipe_back"
            android:textSize="@dimen/cta_secondary_text" />
    </LinearLayout>

    <!--
      中场激励。浮在卡片区下沿之上，靠 alpha 淡入淡出（`SwipeFragment.showMilestone`）。
      声明在 cardStack 之后，所以它画在卡片之上 —— 卡片飞出屏幕时会从它背后穿过。
    -->
    <TextView
        android:id="@+id/milestone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/toast_h"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        android:background="@drawable/bg_toast"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:textColor="@color/toast_text"
        android:textSize="@dimen/toast_text"
        app:layout_constraintBottom_toTopOf="@id/hintRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="已标记删除 20 张 · 约 48 MB" />

    <!-- ============ 滑动提示 ============ -->
    <LinearLayout
        android:id="@+id/hintRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/swipe_hint_pad_h"
        app:layout_constraintBottom_toTopOf="@id/controlsBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/Text.Hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hint_delete"
            android:textColor="@color/delete_red" />

        <TextView
            style="@style/Text.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_keep"
            android:textColor="@color/keep_green" />
    </LinearLayout>

    <!-- ============ 三个控制键 ============ -->
    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/buttonDelete"
            android:layout_width="@dimen/btn_action_size"
            android:layout_height="@dimen/btn_action_size"
            android:background="@drawable/bg_btn_delete"
            android:clickable="true"
            android:contentDescription="@string/cd_btn_delete"
            android:focusable="true"
            android:padding="17dp"
            android:src="@drawable/ic_close"
            app:tint="@color/delete_red" />

        <ImageView
            android:id="@+id/buttonUndo"
            android:layout_width="@dimen/btn_undo_size"
            android:layout_height="@dimen/btn_undo_size"
            android:layout_marginStart="@dimen/controls_gap"
            android:background="@drawable/bg_btn_undo"
            android:clickable="true"
            android:contentDescription="@string/cd_btn_undo"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_undo"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/buttonKeep"
            android:layout_width="@dimen/btn_action_size"
            android:layout_height="@dimen/btn_action_size"
            android:layout_marginStart="@dimen/controls_gap"
            android:background="@drawable/bg_btn_keep"
            android:clickable="true"
            android:contentDescription="@string/cd_btn_keep"
            android:focusable="true"
            android:padding="17dp"
            android:src="@drawable/ic_check"
            app:tint="@color/keep_green" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
