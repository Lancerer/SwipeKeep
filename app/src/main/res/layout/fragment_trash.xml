<?xml version="1.0" encoding="utf-8"?>
<!--
  回收站。列的是系统回收站里的照片，不是 App 内的待删队列。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_top">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="@string/trash_title" />

        <TextView
            android:id="@+id/trashCount"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="182 张" />
    </LinearLayout>

    <TextView
        android:id="@+id/trashTip"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_tip"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="@dimen/tip_pad_v"
        android:text="@string/trash_tip"
        android:textColor="@color/tip_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trashList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_4"
            tools:itemCount="4"
            tools:listitem="@layout/item_trash" />

        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/status_icon_size"
                android:layout_height="@dimen/status_icon_size"
                android:background="@drawable/bg_status_icon"
                android:contentDescription="@null"
                android:padding="17dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/emptyText"
                style="@style/Text.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/trash_empty" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:text="@string/trash_empty_body" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
