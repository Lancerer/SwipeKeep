<?xml version="1.0" encoding="utf-8"?>
<!--
  单张照片卡片的内容。
  由 PhotoCardView 在 init 里设置白底、18dp 圆角与 3dp 阴影；
  这里只负责 8dp 白边、照片与底部信息条。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/photoArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/card_photo_inset"
        android:layout_marginTop="@dimen/card_photo_inset"
        android:layout_marginEnd="@dimen/card_photo_inset"
        android:layout_marginBottom="@dimen/card_caption_h"
        android:background="@drawable/bg_photo_placeholder">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.PhotoCard.Media" />

        <!-- 22% 同色遮罩，alpha 由 setStamp() 驱动 -->
        <View
            android:id="@+id/scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/scrim_delete" />

        <TextView
            android:id="@+id/stamp"
            style="@style/Text.Stamp"
            android:layout_width="@dimen/stamp_w"
            android:layout_height="@dimen/stamp_h"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:gravity="center"
            android:rotation="-6"
            tools:background="@drawable/bg_stamp_delete"
            tools:text="@string/stamp_delete"
            tools:textColor="@color/delete_red" />
    </FrameLayout>

    <TextView
        android:id="@+id/caption"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_marginBottom="14dp"
        android:ellipsize="middle"
        android:maxLines="1"
        tools:text="test.jpg · 109 KB · 2026/10/13" />

</FrameLayout>
