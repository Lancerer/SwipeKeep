<?xml version="1.0" encoding="utf-8"?>
<!--
  范围行与月份行共用。图标、药丸、可点性都由 ScopeRowsAdapter 在每次 bind 时复位。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/row_gap"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/row_h"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/row_corner"
    app:cardElevation="0dp"
    app:rippleColor="@color/surface_soft_pressed"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_h"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="@dimen/space_2">

        <ImageView
            android:id="@+id/tile"
            android:layout_width="@dimen/tile_size"
            android:layout_height="@dimen/tile_size"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@null"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_scope_all"
            app:tint="@color/white"
            tools:backgroundTint="@color/tile_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="全部照片 · 从最近开始" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="1953 张待清理" />
        </LinearLayout>

        <TextView
            android:id="@+id/pill"
            style="@style/Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pill_h"
            android:background="@drawable/bg_pill_recommend"
            android:gravity="center"
            android:paddingHorizontal="@dimen/pill_pad_h"
            android:text="@string/pill_recommend"
            android:textColor="@color/pill_recommend_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_2"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/chevron" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
